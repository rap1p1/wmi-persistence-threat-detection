/*
 * Detection basis: Sigma proc_creation_win_uac_bypass_fodhelper family (C1 overlaps);
 * MITRE T1548.002 DET0388/AN1094 (process-context half). Script-host signal.
 * Telemetry: Sysmon EID 1.
 * Boundary: observes the script host itself, not a required PowerShell child; overlaps
 * C1 on the same event (alert counts are not independent stage counts).
 */
process where
  winlog.event_id == "1"
  and winlog.channel == "Microsoft-Windows-Sysmon/Operational"
  and process.name in ("wscript.exe", "cscript.exe")
  and process.parent.name in ("fodhelper.exe", "cmd.exe")