/*
 * Detection basis: T1070.004 deletion telemetry chained to archive creation. The
 * PowerShell status-channel dependency was REMOVED (the transfer process is curl; a
 * status message must not be read as a transfer).
 * Telemetry: Sysmon EID 11 (zip create) + EID 23 (zip delete).
 * JOIN LIMITATION: EQL cannot bind the created archive path into the deletion event;
 * whether the SAME file.path was created then deleted is asserted by the acceptance
 * verifier from the ledger/event fields. No archive name is hard-coded; no
 * transfer-success inference is made.
 */
sequence by host.name with maxspan=2m

  /* archive creation */
  [file where
    winlog.event_id : "11"
    and winlog.channel : "Microsoft-Windows-Sysmon/Operational"
    and file.extension : "zip"
  ]

  /* archive deletion (same-path verified by the verifier) */
  [file where
    winlog.event_id : "23"
    and winlog.channel : "Microsoft-Windows-Sysmon/Operational"
    and file.extension : "zip"
  ]