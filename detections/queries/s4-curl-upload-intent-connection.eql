/*
 * Detection basis: T1041/T1573-analog upload-intent signal. Replaces the old
 * port-whitelist/private-IP egress rule: a curl process whose command line shows an
 * upload intent, followed by a network connection OWNED by that same curl entity
 * (E1<->E3 by process.entity_id).
 * Telemetry: Sysmon EID 1 + EID 3, both with process.entity_id populated.
 * Boundary: proves "a process with an upload intent made a connection" - NOT that the
 * transfer succeeded (receipt is the transfer proof). No port or IP allow/deny lists.
 */
sequence by host.name, process.entity_id with maxspan=60s

  /* curl with upload-intent arguments */
  [process where
    winlog.event_id : "1"
    and winlog.channel : "Microsoft-Windows-Sysmon/Operational"
    and process.name : "curl.exe"
    and process.command_line : ("*-T *", "*--upload-file*", "*-F *", "*--form*", "*--data-binary*", "*-d *")
  ]

  /* connection made by the same curl entity */
  [network where
    winlog.event_id : "3"
    and winlog.channel : "Microsoft-Windows-Sysmon/Operational"
    and process.name : "curl.exe"
  ]